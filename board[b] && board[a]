<file path="src/__tests__/game-integration.test.ts">
import {
  calculateWinner,
  isBoardFull,
  getNextPlayer,
  createEmptyBoard,
  type CellValue,
  type Player,
  type GameStatus,
} from "@/lib/game-logic";

/**
 * Simulates a game turn, returning the new game state.
 */
function simulateTurn(
  board: CellValue[],
  currentPlayer: Player,
  index: number
): {
  board: CellValue[];
  currentPlayer: Player;
  gameStatus: GameStatus;
  winner: Player | null;
  winLine: number[] | null;
} {
  if (board[index] !== null) {
    return {
      board: [...board],
      currentPlayer,
      gameStatus: "playing",
      winner: null,
      winLine: null,
    };
  }

  const newBoard = [...board];
  newBoard[index] = currentPlayer;

  const { winner, line } = calculateWinner(newBoard);

  if (winner) {
    return {
      board: newBoard,
      currentPlayer,
      gameStatus: "won",
      winner,
      winLine: line,
    };
  }

  if (isBoardFull(newBoard)) {
    return {
      board: newBoard,
      currentPlayer,
      gameStatus: "draw",
      winner: null,
      winLine: null,
    };
  }

  return {
    board: newBoard,
    currentPlayer: getNextPlayer(currentPlayer),
    gameStatus: "playing",
    winner: null,
    winLine: null,
  };
}

describe("Game Integration", () => {
  it("should play a full game where X wins", () => {
    let board = createEmptyBoard();
    let player: Player = "X";

    // X plays 0, O plays 3, X plays 1, O plays 4, X plays 2 (top row win)
    const moves = [0, 3, 1, 4, 2];
    let result;

    for (const move of moves) {
      result = simulateTurn(board, player, move);
      board = result.board;
      player = result.currentPlayer;
    }

    expect(result!.gameStatus).toBe("won");
    expect(result!.winner).toBe("X");
    expect(result!.winLine).toEqual([0, 1, 2]);
  });

  it("should play a full game where O wins", () => {
    let board = createEmptyBoard();
    let player: Player = "X";

    // X:0, O:3, X:1, O:4, X:8, O:5 (O wins middle row)
    const moves = [0, 3, 1, 4, 8, 5];
    let result;

    for (const move of moves) {
      result = simulateTurn(board, player, move);
      board = result.board;
      player = result.currentPlayer;
    }

    expect(result!.gameStatus).toBe("won");
    expect(result!.winner).toBe("O");
    expect(result!.winLine).toEqual([3, 4, 5]);
  });

  it("should play a full game ending in a draw", () => {
    let board = createEmptyBoard();
    let player: Player = "X";

    // A classic draw sequence:
    // X O X
    // X X O
    // O X O
    const moves = [0, 1, 2, 5, 3, 6, 4, 8, 7];
    let result;

    for (const move of moves) {
      result = simulateTurn(board, player, move);
      board = result.board;
      player = result.currentPlayer;
    }

    expect(result!.gameStatus).toBe("draw");
    expect(result!.winner).toBeNull();
  });

  it("should not allow playing on an occupied cell", () => {
    let board = createEmptyBoard();
    let player: Player = "X";

    // X plays at 0
    const result1 = simulateTurn(board, player, 0);
    board = result1.board;
    player = result1.currentPlayer;

    expect(board[0]).toBe("X");
    expect(player).toBe("O");

    // O tries to play at 0 (occupied)
    const result2 = simulateTurn(board, player, 0);

    // Board should be unchanged, player should still be O
    expect(result2.board[0]).toBe("X");
    expect(result2.currentPlayer).toBe("O");
    expect(result2.gameStatus).toBe("playing");
  });

  it("should alternate players correctly", () => {
    let board = createEmptyBoard();
    let player: Player = "X";

    const result1 = simulateTurn(board, player, 0);
    expect(result1.currentPlayer).toBe("O");

    const result2 = simulateTurn(result1.board, result1.currentPlayer, 1);
    expect(result2.currentPlayer).toBe("X");

    const result3 = simulateTurn(result2.board, result2.currentPlayer, 2);
    expect(result3.currentPlayer).toBe("O");
  });

  it("should detect diagonal win", () => {
    let board = createEmptyBoard();
    let player: Player = "X";

    // X:0, O:1, X:4, O:2, X:8 (main diagonal win for X)
    const moves = [0, 1, 4, 2, 8];
    let result;

    for (const move of moves) {
      result = simulateTurn(board, player, move);
      board = result.board;
      player = result.currentPlayer;
    }

    expect(result!.gameStatus).toBe("won");
    expect(result!.winner).toBe("X");
    expect(result!.winLine).toEqual([0, 4, 8]);
  });

  it("should detect anti-diagonal win", () => {
    let board = createEmptyBoard();
    let player: Player = "X";

    // X:2, O:0, X:4, O:1, X:6 (anti-diagonal win for X)
    const moves = [2, 0, 4, 1, 6];
    let result;

    for